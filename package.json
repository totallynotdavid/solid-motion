{
  "name": "@totallynotdavid/solid-motion",
  "version": "0.1.1",
  "private": false,
  "description": "Animation primitives for Solid 2, built on motion-dom.",
  "keywords": [
    "animation",
    "gestures",
    "layout-animation",
    "motion",
    "solid",
    "solid-js",
    "spring"
  ],
  "homepage": "https://github.com/totallynotdavid/solid-motion#readme",
  "bugs": "https://github.com/totallynotdavid/solid-motion/issues",
  "license": "MIT",
  "author": "totallynotdavid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totallynotdavid/solid-motion.git"
  },
  "workspaces": [
    "site"
  ],
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.tsx",
      "default": "./src/index.tsx"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:site": "cd site && bunx vite build",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run install:browsers && bun run test:site",
    "fix": "oxlint -c .oxlintrc.json --fix && oxfmt",
    "install:browsers": "cd site && bunx playwright install ${CI:+--with-deps} chromium",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings && oxfmt --check",
    "prepack": "tsc -p tsconfig.build.json",
    "release:publish": "npm publish --access public",
    "release:tag": "node scripts/release-tag.js",
    "test": "vitest run",
    "test:site": "cd site && bunx vite build && bunx playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site"
  },
  "dependencies": {
    "motion-dom": "^14.4.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.44",
    "@solidjs/web": "^2.0.0-rc.14",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "solid-js": "^2.0.0-rc.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.9",
    "solid-js": "^2.0.0-rc.9"
  }
}
